+//-----------------------------------------------------------------------------
+// Old Source format: the leaf ambient lighting as one light cube per leaf, the way the
+// Old Source compilers write it. Only written once the map has lighting.
+//-----------------------------------------------------------------------------
+static void AddOldSourceLeafAmbientLump( int lumpnum, CUtlVector<dleafambientlighting_t> &samples, CUtlVector<dleafambientindex_t> &index, bool bLit )
+{
+	if ( !bLit || numleafs <= 0 || index.Count() != numleafs )
+		return;
+
+	CUtlVector<OldSourceLeafBox> boxes;
+	boxes.SetCount( numleafs );
+	for ( int i = 0; i < numleafs; i++ )
+	{
+		for ( int a = 0; a < 3; a++ )
+		{
+			boxes[i].mins[a] = dleafs[i].mins[a];
+			boxes[i].maxs[a] = dleafs[i].maxs[a];
+		}
+	}
+
+	COMPILE_TIME_ASSERT( sizeof( dleafambientindex_t ) == 4 );
+	COMPILE_TIME_ASSERT( sizeof( dleafambientlighting_t ) == 28 );
+	COMPILE_TIME_ASSERT( sizeof( CompressedLightCube ) == 24 );
+
+	CUtlVector<CompressedLightCube> cubes;
+	cubes.SetCount( numleafs );
+	int nFilled = OldSource_LeafAmbientCubes( numleafs, boxes.Base(), (const unsigned short *)index.Base(),
+		(const unsigned char *)samples.Base(), samples.Count(), (unsigned char *)cubes.Base() );
+	if ( nFilled )
+	{
+		Msg( "Leaf ambient lighting (Old Source format): %d of %d leaves without samples took the nearest one\n", nFilled, numleafs );
+	}
+
+	// the Old Source compilers write this lump's length as its version; their engine
+	// doesn't check it
+	int len = numleafs * sizeof( CompressedLightCube );
+	AddLumpInternal( lumpnum, cubes.Base(), len, len );
+}
+
+//-----------------------------------------------------------------------------
+// Old Source format: a lit map without HDR lighting doesn't need the HDR default
+// cubemaps vbsp made (the Old Source compilers don't pack them)
+//-----------------------------------------------------------------------------
+static void RemoveUnusedHDRCubemaps( void )
+{
+	if ( dlightdataLDR.Count() == 0 || dlightdataHDR.Count() > 0 )
+		return;
+
+	CUtlVector< CUtlString > hdrFiles;
+	int id = -1;
+	int fileSize;
+	while ( 1 )
+	{
+		char relativeName[MAX_PATH];
+		id = GetNextFilename( GetPakFile(), id, relativeName, sizeof( relativeName ), fileSize );
+		if ( id == -1 )
+			break;
+		int len = V_strlen( relativeName );
+		if ( len > 8 && !V_stricmp( relativeName + len - 8, ".hdr.vtf" ) &&
+			( !V_strnicmp( relativeName, "materials/maps/", 15 ) || !V_strnicmp( relativeName, "materials\\maps\\", 15 ) ) )
+		{
+			hdrFiles.AddToTail( relativeName );
+		}
+	}
+	for ( int i = 0; i < hdrFiles.Count(); i++ )
+	{
+		RemoveFileFromPak( GetPakFile(), hdrFiles[i].Get() );
+	}
+	if ( hdrFiles.Count() )
+	{
+		Msg( "HDR default cubemaps left out (Old Source format: the map has no HDR lighting): %d\n", hdrFiles.Count() );
+	}
+}
